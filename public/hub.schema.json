                                    "enum": [
                                      "mail",
                                      "hash",
                                      "terminal",
                                      "message-square",
                                      "server",
                                      "folder-open",
                                      "activity",
                                      "radar",
                                      "code",
                                      "monitor",
                                      "smartphone"
                                    ]
                                  }
                                },
                                "required": [
                                  "id",
                                  "kind",
                                  "label",
                                  "href"
                                ],
                                "additionalProperties": false
