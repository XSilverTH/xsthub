                                  "icon": {
                                    "type": "string",
                                    "enum": [
                                      "mail",
                                      "hash",
                                      "terminal",
                                      "message-square",
                                      "server",
                                      "folder-open",
                                      "activity",
                                      "radar",
                                      "code",
                                      "monitor",
                                      "smartphone"
                                    ]
                                  }
                                },
                                "required": [
                                  "id",
                                  "kind",
                                  "label",
                                  "value"
                                ],
                                "additionalProperties": false
                              }
                            ]
                          },
                          "minItems": 1
                        }
                      },
                      "required": [
                        "id",
                        "kind",
                        "actions"
                      ],
                      "additionalProperties": false
                    }
                  ]
