                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9-]*$"
                        },
                        "kind": {
                          "type": "string",
                          "const": "copy"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "value": {
                          "type": "string",
                          "minLength": 1
                        },
                        "successLabel": {
                          "type": "string",
                          "minLength": 1
                        },
                        "icon": {
                          "type": "string",
                          "enum": [
                            "mail",
                            "hash",
                            "terminal",
                            "message-square",
                            "server",
                            "folder-open",
                            "activity",
                            "radar",
                            "code",
                            "monitor",
                            "smartphone"
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "kind",
                        "label",
                        "value"
                      ],
                      "additionalProperties": false
