                        "icon": {
                          "type": "string",
                          "enum": [
                            "mail",
                            "hash",
                            "terminal",
                            "message-square",
                            "server",
                            "folder-open",
                            "activity",
                            "radar",
                            "code",
                            "monitor",
                            "smartphone"
                          ]
                        }
