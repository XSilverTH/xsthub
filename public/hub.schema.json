              "actions": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9-]*$"
                        },
                        "kind": {
                          "type": "string",
                          "const": "link"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
