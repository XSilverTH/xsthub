            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "icon": {
                "type": "string",
                "enum": [
                  "mail",
                  "hash",
                  "terminal",
                  "message-square",
                  "server",
                  "folder-open",
                  "activity",
                  "radar",
                  "code",
                  "monitor",
                  "smartphone"
                ]
              },
              "action": {
                "anyOf": [
                  {
                    "type": "object",
